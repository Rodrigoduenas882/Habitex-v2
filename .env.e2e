# Placeholder Supabase config used only to run production builds for Playwright
# smoke tests. Not a real project - no secrets here. Requests against it will
# fail at the network level, which is what the smoke test exercises: the app
# must fail closed (redirect to /login) rather than fake an authenticated state.

VITE_SUPABASE_URL=https://placeholder.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder

# Review/E2E-only: exposes /ui-preview?view=properties (mock fixtures, no
# Supabase calls - see PropertiesVisualPreview's own doc comment). Not set
# in .env/.env.example, so a real `pnpm build` (production) never includes
# it - this mode exists solely for Playwright and an independent reviewer.
VITE_ENABLE_PROPERTIES_PREVIEW=true

# Same reasoning, Sprint 3: exposes /ui-preview?view=rentals (mock fixtures,
# no Supabase calls - see RentalsVisualPreview's own doc comment).
VITE_ENABLE_RENTALS_PREVIEW=true
