# Local-only Supabase stack (`pnpm exec supabase start`), used exclusively by
# the authenticated E2E visual baseline (scripts/e2e-local-seed.mjs +
# playwright.e2e-local.config.ts). Never points at a real/remote project -
# the seed script, build:e2e-local/preview:e2e-local (guarded by
# scripts/assert-local-e2e-env.mjs), and the Playwright config all refuse to
# run otherwise.
#
# Copy this file to .env.e2e-local and fill in real local values. The
# Supabase CLI prints VITE_SUPABASE_URL/VITE_SUPABASE_PUBLISHABLE_KEY on
# `supabase start` (PUBLISHABLE_KEY in its output) - these are fixed local-dev
# defaults, not secrets, but .env.e2e-local stays out of git regardless, same
# as .env.
#
# Never commit .env.e2e-local.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Disposable local-only E2E user, created by scripts/e2e-local-seed.mjs
# against the local Supabase Auth instance only. Any email/password works -
# this account never exists anywhere but the local stack.
E2E_LOCAL_USER_EMAIL=e2e-local@habitex.test
E2E_LOCAL_USER_PASSWORD=
